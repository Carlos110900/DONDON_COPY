{
  "name": "don-do-dontonbori",
  "version": "0.0.1",
  "author": "Diego Orozco, Gonzalo Celis",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Aplicación web para leer cómics y novelas gráficas",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "serve:ssr:DonDoDontonbori": "node dist/DonDoDontonbori/server/server.mjs",
    "fix:error": "eslint .",
    "fix": "eslint . --fix",
    "fix:report": "npx eslint . > eslint-report.txt",
    "format": "prettier --write .",
    "prepare": "husky",
    "api": "json-server --watch api/db.json --port 3001",
    "api:auth": "tsx watch backend/src/app.ts",
    "seed": "tsx backend/src/scripts/seed.ts",
    "dev": "concurrently -n backend,web \"npm:api:auth\" \"npm:start\""
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "zod": "^4.6.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/schematics": "^21.0.0",
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.19",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "angular-eslint": "^21.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^6.15.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^28.0.0",
    "json-server": "^0.17.4",
    "lint-staged": "^16.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,js,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  }
}
